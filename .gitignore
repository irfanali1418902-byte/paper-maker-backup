# Secrets — never commit API keys
.env
.env.*
# ...but the placeholder sample is safe and belongs in the repo
!.env.example
# Local launcher secrets (school PC keys) — never commit
env.local.bat

# SQLite database files (runtime state, not source)
*.db
*.db.*
# WAL-mode sidecar files (hyphen, not dot — *.db.* inhe match nahi karta)
*.db-wal
*.db-shm

# Python build/cache
__pycache__/

# Virtual environment
.venv/
.claude/

# Local Claude Code overrides (machine-specific, not source)
CLAUDE.local.md

# Claude Code setup/onboarding scaffolding (not application code)
paper-maker-claude-setup/

# Design reference (mockups/tokens, not application code)
parcha-design/

# Local archives / backups — not source
*.zip
backups/

# Question images + image library — private, large, E: drive backup alag se
static/uploads/
static/library/
sample_slo_assign.xlsx

# One-shot script ke generated Excel (data artifact, code nahi)
scripts/*.xlsx

# Probe output directories (UI-064). css_type_probe now writes five viewport bands
# per page, so a single run is ~80 MB and a before/after pair ~160 MB. PROBES.md says
# these are not repo artefacts; this line is what makes that true under `git add -A`.
.probe-*/
docs/ui/probe/

# Seeding run logs. STATUS.md §1 kehta hai output hamesha file mein bhejo (aur
# `python -u` ke saath, warna beech mein marne par tail buffer ke saath ghayab
# hota hai) -- wo log ek run ka nishan hai, repo ka artefact nahi. Us ka khulasa
# PROGRESS.md/STATUS.md mein likha jata hai, file khud nahi.
seed*.log
